#!/usr/bin/env bash
# Prépare les fichiers persistants sur AFS, puis lance Hyprland sur le TTY.
set -euo pipefail
script_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
if [ -f "$script_dir/../flake.nix" ]; then
  NC_FLAKE_DIR="${NC_FLAKE_DIR:-$(realpath "$script_dir/..")}"
  export NC_FLAKE_DIR
fi
# shellcheck source=epita/env.sh
. "${NC_FLAKE_DIR:-$HOME/afs/.confs/noctalia-config-nixos}/epita/env.sh"

# Les résultats sont propres au compte et réévalués après un git pull.
exec 9>"$NC_RUNTIME_DIR/prepare.lock"
flock 9
echo "==> Préparation de l'environnement Nix EPITA..."
nix --extra-experimental-features 'nix-command flakes' build "path:$NC_FLAKE_DIR#epita-env" -o "$NC_ENV_LINK"
nix --extra-experimental-features 'nix-command flakes' build "path:$NC_FLAKE_DIR#zshCustom" -o "$NC_ZSH_LINK"
nix --extra-experimental-features 'nix-command flakes' build "path:$NC_FLAKE_DIR#source" -o "$NC_SOURCE_LINK"
python3 "$NC_FLAKE_DIR/epita/prepare.py" "${1:---check}"
flock -u 9
exec 9>&-
if [ "${1:-}" = --check ] || [ "${1:-}" = --reinstall ]; then
  echo "==> Configuration EPITA prête (configurations et Pictures sur AFS)."
  exit 0
fi
# Reprendre les variables Qt et GPU prévues par la configuration amont.
# Ces fichiers POSIX contiennent des tests dont le résultat peut être faux.
set +e
for session_env in "$HOME/.config/uwsm/env" "$HOME/.config/uwsm/env-hyprland"; do
  if [ -r "$session_env" ]; then
    # shellcheck disable=SC1090
    . "$session_env"
  fi
done
set -e
case "$(tty 2>/dev/null || true)" in
  /dev/tty[0-9]*) unset DISPLAY WAYLAND_DISPLAY ;;
esac
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=Hyprland
# Les sockets n'existent qu'après le démarrage : nc-session est appelé par Lua.
trap '"$NC_FLAKE_DIR/epita/nc-session" --stop' EXIT
Hyprland "$@"
