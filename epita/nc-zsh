#!/usr/bin/env bash
# nc-zsh : Lance le terminal Zsh configuré (oh-my-zsh + powerlevel10k + outils Nix en RAM)
set -euo pipefail

if [ ! -x /tmp/nc-epita-env/bin/zsh ]; then
  "$HOME/afs/bin/nc-start" --version >/dev/null 2>&1 || true
fi

export PATH="/tmp/nc-epita-env/bin:$HOME/.local/bin:$HOME/afs/bin:$PATH"
export XDG_DATA_DIRS="/tmp/nc-epita-env/share:${XDG_DATA_DIRS:-/run/current-system/sw/share}"
export ZSH="/tmp/nc-epita-env/share/oh-my-zsh"
export ZSH_CUSTOM="/tmp/nc-zsh-custom"

if [ ! -f "$HOME/.zshrc" ] && [ -f /tmp/nc-source/home/.zshrc ]; then
  cp -f /tmp/nc-source/home/.zshrc "$HOME/.zshrc"
  cp -f /tmp/nc-source/home/.p10k.zsh "$HOME/.p10k.zsh"
fi

exec /tmp/nc-epita-env/bin/zsh "$@"
