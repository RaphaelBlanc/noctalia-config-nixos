#!/usr/bin/env bash
# Kitty utilise ce shell, même si le shell de connexion de l'école est bash.
set -euo pipefail
script_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
if [ -f "$script_dir/../flake.nix" ]; then
  NC_FLAKE_DIR="${NC_FLAKE_DIR:-$(realpath "$script_dir/..")}"
  export NC_FLAKE_DIR
fi
# shellcheck source=epita/env.sh
. "${NC_FLAKE_DIR:-$HOME/afs/.confs/noctalia-config-nixos}/epita/env.sh"
if [ ! -x "$NC_ENV_LINK/bin/zsh" ] || [ ! -f "$HOME/.config/nc/greeting.zsh" ]; then
  "$NC_FLAKE_DIR/epita/nc-start" --check
fi
unset FASTFETCH_SHOWN
exec "$NC_ENV_LINK/bin/zsh" "$@"
